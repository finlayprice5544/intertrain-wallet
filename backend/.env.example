# ───────────────────────────────────────────────────────────────
#  Intertrain Wallet clone (Rust / Axum).  Copy to `.env` and fill in.
#  (Per-project subset of the master `.env.example`. On Railway, set
#   these as service Variables instead of shipping a .env.)
#  Boots even empty: RocksDB is embedded (always on), ClickHouse is
#  optional (falls back to RocksDB seed if unreachable), external APIs
#  fall back to seeded data when keys are missing (DATA_MODE=auto).
# ───────────────────────────────────────────────────────────────

PORT=8787
RUST_LOG=info,generated_site=debug

# ── Branding / the knobs you change per project ────────────────
#  (override config/branding.json; also applied to the cloned
#   frontend by `cargo run --bin rebrand`.)
SITE_NAME="My Wallet"
TOKEN_TICKER="TICKER"
CONTRACT_ADDRESS=""           # CA — your token mint
TWITTER_URL="https://x.com/yourhandle"
GITHUB_URL="https://github.com/youruser/yourrepo"
DISCORD_URL="https://discord.gg/yourinvite"
TELEGRAM_URL="https://t.me/yourchannel"
WEBSITE_URL="https://yoursite.example"

# ── Data layer ─────────────────────────────────────────────────
#  seed = serve from RocksDB seed only (offline, always works)
#  live = call ClickHouse + external services (needs them up)
#  auto = live, fall back to seed on error/missing (default)
DATA_MODE="auto"
ROCKSDB_PATH="./data/rocks"
PUBLIC_DIR="../frontend"       # the cloned frontend folder (sibling of backend/)

# ── ClickHouse (analytics / events / time-series) ──────────────
#  Easiest: `docker compose up -d clickhouse` then use the defaults below.
#  If empty/unreachable the app boots fine — analytics routes return seed data.
CLICKHOUSE_URL="http://localhost:8123"
CLICKHOUSE_DATABASE="app"
CLICKHOUSE_USER="default"
CLICKHOUSE_PASSWORD=""

# ── Solana / RPC (read-only; execution is simulated) ───────────
#  Used by the SOL->WSK bridge lane quote (sol_mna_quote).
#  Falls back to simulated data if unreachable.
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
HELIUS_API_KEY=""             # dev.helius.xyz — if set and SOLANA_RPC_URL blank, URL is derived
SOLANA_CLUSTER="mainnet-beta"

# ── Chain RPC URLs (the wallet's own chain) ────────────────────
#  These are the original Intertrain RPC URLs. The backend simulates
#  all chain calls locally so these are NOT required to boot.
#  Set them if you want to proxy to a real node instead of simulating.
CHAIN_RPC_URL=""              # e.g. https://rpc-worldstreet.intertrain.online/rpc
CHAIN_RPC_MAINNET_URL=""      # e.g. https://rpc.intertrain.online/rpc
CHAIN_RPC_TESTNET_URL=""      # e.g. https://rpc-testnet.intertrain.online/rpc
CHAIN_ID="worldstreet-1"
CHAIN_NATIVE_SYMBOL="WSK"
CHAIN_NATIVE_DECIMALS=6

# ── Bridge configuration ──────────────────────────────────────
#  Bridge lanes are simulated. Set these for display or if you wire
#  up real bridge contracts later.
BRIDGE_ETH_NETWORK="sepolia"
BRIDGE_ETH_CONTRACT=""        # Ethereum bridge contract address
BRIDGE_SOL_NETWORK="devnet"
BRIDGE_SOL_PROGRAM=""         # Solana bridge program ID

# ── Reserve swap (MNA) ────────────────────────────────────────
#  Fixed USDC->WSK conversion rate used in mna_quote / mna_swap.
MNA_RATE="0.10"               # 1 USDC = 10 WSK
MNA_COLLATERALIZED="true"

# ── Auth ───────────────────────────────────────────────────────
#  Session tokens are simulated (no real signing verification).
AUTH_SESSION_TTL_SECS=86400   # 24 hours
AUTH_CHALLENGE_DOMAIN=""      # override the domain in challenge messages

# ── Faucet (devnet only) ──────────────────────────────────────
FAUCET_AMOUNT="10000000000"   # 10,000 WSK in microWSK
FAUCET_COOLDOWN_SECS=60       # min seconds between drips per address

# ── Market data ────────────────────────────────────────────────
DEXSCREENER_BASE="https://api.dexscreener.com"   # no key
JUPITER_BASE="https://lite-api.jup.ag"           # no key on lite
BIRDEYE_API_KEY=""            # birdeye.so (optional)

# ── Storage / token metadata ───────────────────────────────────
PINATA_JWT=""                 # pinata.cloud (only if pinning)
IPFS_GATEWAY="https://ipfs.io/ipfs/"

# ── Explorer / domain URLs (for frontend rebrand) ─────────────
EXPLORER_URL=""               # e.g. https://explorer.intertrain.online
WALLETS_URL=""                # e.g. https://wallets.yoursite.example
DOMAIN=""                     # e.g. yoursite.example
DOMAIN_WALLETS=""             # e.g. wallets.yoursite.example
CHAIN_REF=""                  # e.g. "chain 4683" -> "chain 0000"
NETWORK_NAME=""               # e.g. worldstreet -> mychain
CHAIN_RPC_HEALTHZ_URL=""      # healthz endpoint URL
CHAIN_RPC_METRICS_URL=""      # metrics endpoint URL
